NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

DATABASE_URL=postgresql://USER:PASSWORD@HOST/refugiapp_development
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=5
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=true

HEALTH_DB_TIMEOUT_MS=2000
HEALTH_DEGRADED_LATENCY_MS=500

TRUST_PROXY_HOPS=0
RATE_LIMIT_GENERAL_LIMIT=1000
RATE_LIMIT_GENERAL_TTL_MS=60000
RATE_LIMIT_LOGIN_LIMIT=20
RATE_LIMIT_LOGIN_TTL_MS=60000

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=
INITIAL_ADMIN_RESET_PASSWORD=false
INITIAL_ADMIN_SEED_ALLOW_PRODUCTION=false

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=refugiapp-api-development
JWT_AUDIENCE=refugiapp-mobile-development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_SECURE=true

MEDIA_ORPHAN_RETENTION_HOURS=48
MEDIA_ORPHAN_PURGE_LIMIT=500
