NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=api/v1
# Structured logging level (log, error, warn, debug, verbose, fatal)
LOG_LEVEL=log

# Neon PostgreSQL
# Use the pooled Neon connection string when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=10
# Must remain false in production.
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# Health checks
# Timeout for the database readiness probe.
HEALTH_DB_TIMEOUT_MS=2000
# Latency from which the database is reported as degraded (still serving traffic).
HEALTH_DEGRADED_LATENCY_MS=500

# HTTP security and rate limiting
# Set to the exact number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0
RATE_LIMIT_GENERAL_LIMIT=100
RATE_LIMIT_GENERAL_TTL_MS=60000
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_TTL_MS=60000

# Initial admin seed
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_FIRST_NAME=Initial
INITIAL_ADMIN_LAST_NAME=Admin
INITIAL_ADMIN_RESET_PASSWORD=false
INITIAL_ADMIN_SEED_ALLOW_PRODUCTION=false

# JWT
# Use a random value with at least 32 characters. Do not use a placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=refugiapp-api
JWT_AUDIENCE=refugiapp-mobile

# Cloudinary (required in production; optional in development/test)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true

